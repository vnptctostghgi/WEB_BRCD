# Copy file này thành .env trên PC server. Không commit .env thật.
APP_NAME=Hệ thống quản trị đặc biệt
APP_ENV=production
APP_PUBLIC_URL=https://vnptcto.com
APP_DATABASE_BACKEND=supabase
PRODUCTION_STRICT_STARTUP=true

# Phải giữ nguyên các giá trị đang dùng trên Render để bảo toàn phiên và dữ liệu.
SESSION_SECRET=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
SUPABASE_REST_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

INTERNAL_API_URL=http://10.92.17.88:8000/api/du-lieu-web
INTERNAL_API_MOCK_MODE=false
INTERNAL_API_TIMEOUT_SECONDS=20
INTERNAL_API_TOKEN=

TELEGRAM_TOKEN=
BOT_TOKEN=
MY_TELEGRAM_ID=
BOT_USERNAME=

ZALO_BOT_TOKEN=
ZALO_WEBHOOK_URL=https://vnptcto.com/api/zalo/webhook
ZALO_WEBHOOK_SECRET=
ZALO_AUTO_REPLY_ENABLED=true

ONEBSS_LOGIN_URL=https://onebss.vnpt.vn/
ONEBSS_USERNAME=
ONEBSS_PASSWORD=
ONEBSS_DOWNLOAD_TIMEOUT_SECONDS=180

GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_IMPERSONATED_USER=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://vnptcto.com/api/google-drive/oauth/callback

MOBILE_GATEWAY_ENABLED=true
MOBILE_GATEWAY_MASTER_KEY=
OTP_ENCRYPTION_KEY=
MOBILE_GATEWAY_PAIRING_TTL_SECONDS=600
MOBILE_GATEWAY_HMAC_MAX_CLOCK_SKEW_SECONDS=300
MOBILE_GATEWAY_ONLINE_THRESHOLD_SECONDS=180

INTERNAL_EMAIL_SYNC_ENABLED=false
INTERNAL_EMAIL_HOST=email.vnpt.vn
INTERNAL_EMAIL_PORT=993
INTERNAL_EMAIL_USERNAME=
INTERNAL_EMAIL_PASSWORD=
INTERNAL_EMAIL_MAILBOX=INBOX

# Docker/Tunnel. Tạo token từ Cloudflare Zero Trust; không đưa token lên Git.
CLOUDFLARE_TUNNEL_TOKEN=
VNPTCTO_LOCAL_PORT=8080

